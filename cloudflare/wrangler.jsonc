{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oda-pagos",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": false
  },
  "vars": {
    "SITE_URL": "https://armando858d.github.io/ODA",
    "API_URL": "https://oda-pagos.oda-pagos-cloudflare.workers.dev",
    "MP_MODE": "live",
    "MP_COLLECTOR_ID": "317801554",
    "MP_MAX_INSTALLMENTS": "12",
    "PAYMENTS_ENABLED": "false",
    "PICKUP_CONFIRMED": "false",
    "SHIPPING_RATES_CONFIRMED": "false",
    "SHIPPING_LOCAL": "50",
    "SHIPPING_CENTRO": "150",
    "SHIPPING_NACIONAL": "220",
    "SHIPPING_PROVIDER": "skydropx",
    "SKYDROPX_MODE": "live",
    "SKYDROPX_TEST_API_URL": "https://sb-pro.skydropx.com",
    "SKYDROPX_LABEL_PURCHASES_ENABLED": "false",
    "LABEL_PURCHASES_ENABLED": "false",
    "MAX_LABEL_COST_MXN": "0",
    "AUTO_LABELS_ENABLED": "false",
    "RESERVATION_RECOVERY_ENABLED": "true",
    "EMAIL_ENABLED": "false",
    "EMAIL_FROM": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oda-pedidos",
      "database_id": "69b5732d-cdb1-4dc8-b95d-c3a7db085ff4",
      "migrations_dir": "migrations"
    }
  ]
}
